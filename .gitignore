# Dependencies
**/node_modules

# Environment variables — never commit real secrets. .env.example files
# (safe templates with no real values) are intentionally NOT ignored.
**/.env
**/.env.local
**/.env.*.local

# Next.js build output
**/.next/
**/out/

# Backend build output
backend/dist/

# TypeScript build info
**/*.tsbuildinfo
frontend/next-env.d.ts

# Logs
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/.pnpm-debug.log*

# OS files
**/.DS_Store

# Editor
.vscode/
.idea/

# Vercel
**/.vercel

# Local transformer model weights (downloaded on first run)
backend/.model-cache/
