# ─── Server ───────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ─── CORS ─────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ─── Database ─────────────────────────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# For local development with Homebrew PostgreSQL (no password):
# DATABASE_URL="postgresql://YOUR_USERNAME@localhost:5432/hack_guru_db"
#
# To create the database:
#   brew services start postgresql@14
#   createdb hack_guru_db
#   npx prisma migrate dev --name init
#   npx prisma db seed
DATABASE_URL="postgresql://postgres@localhost:5432/hack_guru_db"
# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_strong_jwt_secret_here
JWT_EXPIRES_IN=7d

# ─── Gemini AI ────────────────────────────────────────────────────────────────
# Get free key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ─── Brabble AI — External Opportunity Data ───────────────────────────────────
# Free tier: 1,000 requests/day. Get key at: https://brabble.ai/dashboard
# Leave blank to skip external sync (existing PostgreSQL data still works).
BRABBLE_API_KEY=
BRABBLE_API_BASE_URL=https://brabble.ai/api
EVENT_API_MAX_PAGES=5
EVENT_API_PAGE_SIZE=50

# ─── Admin Sync Endpoint ──────────────────────────────────────────────────────
# Protects POST /api/admin/events/sync. Must be passed as x-admin-secret header.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SYNC_SECRET=your_admin_sync_secret_here
